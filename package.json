{
  "name": "foundry-clarion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply foundry-clarion-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply foundry-clarion-db --remote"
  },
  "dependencies": {
    "@foundry/auth": "file:vendor/foundry-auth-0.1.0.tgz",
    "@tanstack/react-query": "^5.71.0",
    "@twilio/voice-sdk": "^2.18.3",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "hono": "^4.7.0",
    "jose": "^5.10.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.6.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^3.2.4",
    "wrangler": "4.104.0"
  }
}
